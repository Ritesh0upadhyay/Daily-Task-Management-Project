// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name String    @db.VarChar(100)
  last_name  String    @db.VarChar(100)
  email      String    @unique @db.VarChar(255)
  password   String    @db.Text

  manager_id String?   @db.Uuid
  manager    User?     @relation("UserManager", fields: [manager_id], references: [id])
  subordinates User[]  @relation("UserManager")

  // Task relations
  ownedTasks       Task[] @relation("TaskOwner")
  assignedTasks    Task[] @relation("TaskAssignee")
  modifiedTasks    Task[] @relation("TaskModifiedBy")

  // Notification relation
  notifications    Notification[] @relation("UserNotifications")

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz
}
model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title       String     @db.Text
  description String?    @db.Text

  owner_id    String?    @db.Uuid
  owner       User?      @relation("TaskOwner", fields: [owner_id], references: [id])

  assignee_id String?    @db.Uuid
  assignee    User?      @relation("TaskAssignee", fields: [assignee_id], references: [id])

  priority    Int        @default(2) @db.SmallInt
  status      String     @default("pending") @db.VarChar(30)
  due_date    DateTime?  @db.Date

  created_at  DateTime   @default(now()) @db.Timestamptz
  updated_at  DateTime   @default(now()) @db.Timestamptz

  modified_by String?    @db.Uuid
  modifiedBy  User?      @relation("TaskModifiedBy", fields: [modified_by], references: [id])

  modified_on DateTime   @default(now()) @db.Timestamptz
}
model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  user_id       String?   @db.Uuid
  user          User?     @relation("UserNotifications", fields: [user_id], references: [id])

  type          String?   @db.VarChar(30)   // reminder | summary_email
  payload       String?   @db.Text         // changed from Json to String

  scheduled_for DateTime? @db.Timestamptz
  sent_at       DateTime? @db.Timestamptz

  status        String    @default("pending") @db.VarChar(20) // pending | sent | failed
}
